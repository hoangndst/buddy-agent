# Model Provider (OpenAI-compatible: Ollama, vLLM, OpenRouter, DeepSeek, OpenAI, etc.)
# BUDDY_* variables take precedence to avoid conflicts with other CLI tools or global OPENAI_* vars.
# Generic OPENAI_BASE_URL and OPENAI_API_KEY remain supported as automatic fallbacks.
BUDDY_BASE_URL=http://localhost:11434/v1
BUDDY_API_KEY=your-api-key-here
BUDDY_MODEL=qwen2.5-coder:7b

# API Protocol: auto (default, auto-negotiates), chat (/v1/chat/completions), or responses (/v1/responses)
BUDDY_API_TYPE=auto

# Reasoning Effort (optional for reasoning models: none, low, medium, high)
BUDDY_REASONING_EFFORT=

# Agent Behavior
BUDDY_MAX_STEPS=30
BUDDY_MAX_OUTPUT_CHARS=10000
BUDDY_WORKSPACE=.
BUDDY_DEBUG=false
